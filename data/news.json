  "transfers": [
    {
      "title": "مذاکرات قرارداد رئال مادرید و علاقه آرسنال - آینده وینیسیوس جونیور چیست؟",
      "desc": "با تمدید مذاکرات رئال مادرید و ابراز علاقه آرسنال، ممکن است در حال حاضر هیچ موقعیت جذاب تر از آینده وینیسیوس جونیور در نقل و انتقالات وجود نداشته باشد.",
      "img": "https://ichef.bbci.co.uk/ace/standard/960/cpsprodpb/5d30/live/def92a80-89a0-11f1-b2ab-0dd01740f9f6.jpg"
    },
    {
      "title": "دیوماند با دور شدن پاری سن ژرمن با شرایط رئال مادرید موافقت کرد",
      "desc": "یان دیوماند، وینگر آر بی لایپزیگ پس از انصراف پاریسن ژرمن، با شرایط شخصی رئال مادرید موافقت کرد.",
      "img": "https://ichef.bbci.co.uk/ace/standard/960/cpsprodpb/5633/live/e88d1110-8964-11f1-b5c7-f34a712b7d61.jpg"
    },
    {
      "title": "سیموندز کاپیتان برایتون قرارداد بلندمدت جدیدی امضا کرد",
      "desc": "میزی سیموندز، کاپیتان برایتون، قرارداد جدیدی را امضا کرد که باشگاه آن را بلندمدت توصیف کرد.",
      "img": "https://ichef.bbci.co.uk/ace/standard/960/cpsprodpb/7ca0/live/00c939c0-89a6-11f1-a85a-79136c2d298e.jpg"
    },
    {
      "title": "اسکالونی، سرمربی آرژانتین کنفرانس مطبوعاتی را با گریه ترک کرد",
      "desc": "لیونل اسکالونی، سرمربی تیم ملی آرژانتین، پس از شکست روز یکشنبه در فینال جام جهانی مقابل اسپانیا، کنفرانس خبری پس از بازی خود را با گریه ترک کرد و درباره آینده خود صحبت کرد.",
      "img": "https://ichef.bbci.co.uk/ace/standard/960/cpsprodpb/0fe8/live/acf179d0-842c-11f1-bee8-53ce494e1abc.jpg"
    },
    {
      "title": "در حال حرکت - جوانترین کارآموزان فوتبال",
      "desc": "بازیکنانی که تا تولد 23 سالگی خود در تعداد قابل توجهی از باشگاه ها ظاهر شده بودند.",
      "img": "https://ichef.bbci.co.uk/ace/standard/960/cpsprodpb/2415/live/043bf610-87a8-11f1-b4f4-2f10373ed74c.jpg"
    },
    {
      "title": "مک‌اینز به رنجرز مبنی بر امضای قرارداد ظرف 48 ساعت اذیت می‌کند",
      "desc": "رنجرز امیدوار است تا ظرف 48 ساعت آینده یک خرید دیگر را اعلام کند، و درک مک‌اینز، سرمربی تیم، یک ثانیه هم تا زمانی که تیمش فصل خود را در خارج از خانه مقابل داندی یونایتد در روز جمعه باز می‌کند، یک ثانیه اذیت می‌کند.",
      "img": "https://ichef.bbci.co.uk/ace/standard/960/cpsprodpb/f5a8/live/8a2f6cd0-8932-11f1-8854-83ac9c49426d.jpg"
    },
    {
      "title": "بازیکنان ناراضی تاتنهام باید بروند - دزربی",
      "desc": "روبرتو دزربی، سرمربی تاتنهام می‌گوید بازیکنانی که از ماندن در این باشگاه افتخار نمی‌کنند و خوشحال نیستند، باید این باشگاه را ترک کنند.",
